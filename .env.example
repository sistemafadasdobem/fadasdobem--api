# ─── Aplicação ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Versão exposta em /health e /ping (opcional; default no código: 1.0.0)
APP_VERSION=1.0.0
API_PUBLIC_URL=http://localhost:3000
# Esquema: `npm start` corre `migrations/` (recomendado). NÃO ative Sequelize sync em PRD com alter.
# true = apenas opt-in sync na app (`alter` só se SEQUELIZE_SYNC_ALTER=true). force ainda assim exige SEQUELIZE_SYNC_FORCE.
SEQUELIZE_SYNC=false
# Com SEQUELIZE_SYNC=true: altera colunas existentes (perigoso). Prefira novas entradas em migrations/.
SEQUELIZE_SYNC_ALTER=false
# Apaga e recria TODAS as tabelas. Pode correr sem SEQUELIZE_SYNC=true (ver app.js).
SEQUELIZE_SYNC_FORCE=false
# Atrás de reverse proxy (Easypanel, nginx): true para rate limit e req.ip corretos
TRUST_PROXY=false
# TRUST_PROXY_COUNT=1
# Homolog / staging: true desativa limite de tentativas em login e registo (5/IP e 10/email / 15 min). Evita HTTP 429 ao alternar cliente e taróloga.
# Em produção deixe vazio ou false.
# AUTH_RATE_LIMIT_DISABLED=true

# Socket.io (filas inteligentes) — origem(es) admitidas pelo handshake WS (ex.: http://localhost:5173 ou lista separada por vírgulas)
SOCKET_CORS_ORIGIN=*

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fadasdobem
DB_USER=postgres
DB_PASSWORD=COLE_SENHA_DO_POSTGRES
DB_LOGGING=false
# Opcional (PRD): sobrepõe host/user/pass acima quando preenchido
DATABASE_URL=
# PRD com SSL (ex.: RDS): defina true se necessário
DB_SSL=false

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_URL=

# BullMQ worker embutido: fila `delivery-queue` (entrega outbound Chatwoot pós‑pagamento / outbox pendente).
# Em cluster com vários pods, ponha apenas em **um** processo `true`; demais ficam apenas produtor HTTP.
DELIVERY_QUEUE_WORKER=false
# Prazo máximo (ms) para drenar HTTP + BullMQ (worker.close + queue.close) + Sequelize após SIGTERM/SIGINT (5 000–120 000).
GRACEFUL_SHUTDOWN_MS=28000

# ─── Parâmetros Nice (`src/config/business.config.js`; omitir para defaults) ─
# CLIENT_RESERVATION_MINUTES=5
# SESSION_MINIMUM_FLOOR_MINUTES=15
# STEP_UP_SESSION_DURATION_MINUTES=5
# NAME_ID_GENERATION_LOGIC=FIRST_AND_LAST
# SPECIALIST_RESERVATION_JOB_INTERVAL_MS=60000
# JWT_STEP_UP_VERIFIED_AT_CLAIM=step_up_verified_at
# STEP_UP_HTTP_HEADER_NAME=x-step-up-verified-at
# SESSION_FLOOR_ELIGIBLE_END_REASONS=SPECIALIST_DISCONNECT,PLATFORM_ERROR,...

# ─── JWT (gere segredos longos, ex.: openssl rand -hex 32) ───────────────────
JWT_SECRET=GERE_SEGREDO_MINIMO_32_CARACTERES_EX_openssl_rand_hex_32
JWT_EXPIRES_IN=30m
JWT_ISSUER=fadasdobem-api
JWT_AUDIENCE=fadasdobem-clients

JWT_REFRESH_SECRET=GERE_OUTRO_SEGREDO_MINIMO_32_CARACTERES
JWT_REFRESH_EXPIRES_IN=12h

# ─── E-mail (Resend — `src/providers/mail/`) ───────────────────────────────────
RESEND_API_KEY=re_ColeSuaChaveResendAqui
EMAIL_FROM="Fadas do Bem <contato@seudominio.com.br>"

# ─── Evolution API ───────────────────────────────────────────────────────────
EVOLUTION_API_BASE_URL=https://COLE_URL_PUBLICA_DA_SUA_EVOLUTION_API
EVOLUTION_GLOBAL_API_KEY=COLE_SUA_EVOLUTION_GLOBAL_API_KEY
EVOLUTION_WEBHOOK_GLOBAL_URL=
# Instância WhatsApp‑Baileys ligada ao Chatwoot (sendText / sendButtons / sendList v2).
EVOLUTION_WHATSAPP_INSTANCE_NAME=fadas_whatsapp

# ─── Chatwoot ────────────────────────────────────────────────────────────────
CHATWOOT_BASE_URL=https://COLE_URL_PUBLICA_DO_SEU_CHATWOOT
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=COLE_SEU_TOKEN_USER_OU_PLATFORM_CHATWOOT
CHATWOOT_IA_HISTORY_N=30
# Fluxo estruturado Lead (PostgreSQL bot_conversation_flow_states + Evolution). Não exige Claude.
CHATWOOT_LEAD_FSM_ENABLED=false
#
CHATWOOT_LEAD_FSM_MIRROR_TO_CHATWOOT=false
# Dev: permite avançar T4→T5 com texto simulando confirmação de pagamento.
CHATWOOT_LEAD_FSM_DEV_CONFIRM_PAY=false
# Conversão Lead→User no fluxo T8 (`convertLeadToClient`)
LEAD_FSM_ACCEPTED_TERMS_VERSION=lead-fsm-v1
# E-mail fake “titular PIX” só para criar cobrança MP no Lead FSM (não usa inbox real da cliente).
LEAD_FSM_MP_GUEST_EMAIL_DOMAIN=clients.fadasdobem.invalid
LEAD_FSM_MP_GUEST_MAILBOX=lead.pay
# Se true (ou 1 / yes / on), webhook responde no Chatwoot com IA. false ou vazio = não responde (útil no dev).
CHATWOOT_IA_AUTO_REPLY=false
# Logs de diagnóstico webhook → IA (omitir ou true). false silencia `[chatwoot:webhook]` e relacionados neste fluxo.
CHATWOOT_WEBHOOK_LOG=true
# Opcional: só se quiseres restringir números na IA. Sem variável = todos (veja chatwoot.service.js).
CHATWOOT_IA_PHONE_WHITELIST=
# Opcional — horas entre avisos “Leads Agenda” ao mesmo prospecto quando a mesma taróloga volta ONLINE (evita spam)
# LEADS_AGENDA_NOTIFY_COOLDOWN_HOURS=24

# ─── Provedor de IA: anthropic | openai ───────────────────────────────────────
ACTIVE_AI_PROVIDER=anthropic

# ─── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-COLE_SUA_CHAVE_ANTHROPIC_AQUI
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_MAX_TOOL_ROUNDS=10
# Logs `[anthropic:claude]` (rounds, uso, latência). false silencia no PRD se necessário.
ANTHROPIC_SERVICE_LOG=true

# ─── OpenAI (Assistants v2) ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-COLE_SUA_CHAVE_OPENAI_OU_DEIXE_VAZIO
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_DISPLAY_NAME=
OPENAI_ASSISTANT_REGISTRY_SLUG=
OPENAI_ASSISTANT_ID=
OPENAI_RUN_POLL_MS=750
OPENAI_RUN_MAX_POLL_ATTEMPTS=60

# ─── Opcional ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=
# Front web (URLs em notas slash no Chatwoot, ex.: /gerar_link → /sala?…)
FRONTEND_URL=https://seudominio.com.br

# ─── Agora.io (RTC web — Fase 5 + Conversational AI REST) ────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Basic Auth Agora REST (kick/ban list, outros endpoints REST): Developer Toolkit → RESTful API
# Na API Conversational AI também pode usar `Authorization: agora token=<RTC token gerado no servidor>`
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Opcional: base da API Conversational AI (default https://api.agora.io)
# AGORA_CONVERSATIONAL_AI_BASE_URL=

# Homologação — após migrate: `npm run seed:homolog` cria client + taróloga + carteira (ver script).
# GET /api/v1/config/public expõe agora_app_id + e-mails + specialist_id da BD.
# SEED_HOMOLOG_EMAIL=homolog@fadasdobem.test
# SEED_HOMOLOG_PASSWORD=Homolog@2026
# SEED_HOMOLOG_SPECIALIST_EMAIL=tarologa.homolog@fadasdobem.test
# SEED_HOMOLOG_SPECIALIST_PASSWORD=TarologaHomolog@2026
# SEED_FORCE_PASSWORD_RESET=true

# ─── Intelbras WideVoice (api.php — POST JSON: acao, login, token) ────────────
# Base **sem** /api.php (ex.: https://fadasdobem.intelbrasvoice.com.br)
INTELBRAS_WIDEVOICE_BASE_URL=
INTELBRAS_WIDEVOICE_LOGIN=
INTELBRAS_WIDEVOICE_TOKEN=
# GET `/api/v1/telecom/widevoice-check` — probe público (`statusramais` com estas credenciais; **sem** lab/segredo). Default **ligado**; PRD: INTELBRAS_WIDEVOICE_PUBLIC_PROBE=false para desligar.
# INTELBRAS_WIDEVOICE_PUBLIC_PROBE=true
# Timezone IANA para `statusoperacoes` quando só passas datas parciais (default São Paulo).
# INTELBRAS_WIDEVOICE_TZ=America/Sao_Paulo
# Janela quando não mandas datainicio/datafim em statusoperacoes (ms, máx 7 dias · default 24h).
# INTELBRAS_STATUSOPERACOES_LOOKBACK_MS=86400000
# Path da API no host acima (default /api.php)
# INTELBRAS_WIDEVOICE_API_PATH=/api.php
# Compat legado — se só isto existir, o código deriva o host removendo sufixo /api ou /api.php
# INTELBRAS_REST_URL=https://fadasdobem.intelbrasvoice.com.br
# INTELBRAS_REST_LOGIN=
# INTELBRAS_REST_TOKEN=
# INTELBRAS_REST_TIMEOUT_MS=15000
# DDD “local” da central sem tronco extra (default 11 — ex. discagem na área da PBX)
# INTELBRAS_DIAL_LOCAL_DDD=11
# false = apenas DDD+número para qualquer destino brasileiro (ex. `71982809246`), **sem** `011` antes do DDD (use se a conta WideVoice assim exigir)
# Omitir ou true = DDD≠local ganha prefixo trunk `011` (regra típida saindo de SP · default no código).
# INTELBRAS_DIAL_USE_011_FOR_NON_LOCAL=false
# INTELBRAS_CLICKTOCALL_PREPEND_ZERO — se true e tronco 011 desligado, DDD≠local com `0`+DDD+número (ex. `071982809246`); tentar se CHAMADA OK não tocar.
# INTELBRAS_CLICKTOCALL_PREPEND_ZERO=false
# Código/rota só dígitos antes do nacional quando DDD≠local e sem 011 · ex.: 015 ⇒ 01571983141335 (consultar trunk/suporte)
# INTELBRAS_CLICKTOCALL_PREPEND_ROUTE=
# Móvel BR: remove o 9 inicial após DDD quando o assinante tem 9 dígitos (ex. 71 98280… → 71 8280…). Útil se a central marcar sem o 9.
# INTELBRAS_CLICKTOCALL_DROP_MOBILE_NINE=false
# Campo do body em liberarramal (default ramal) — ajustar se o suporte indicar outro nome
# INTELBRAS_WIDEVOICE_LIBERAR_RAMAL_FIELD=ramal
# Só se a instância expuser `desligar` por uniqueid após liberarramal
# INTELBRAS_WIDEVOICE_TRY_DESLIGAR_BY_UID=false
# Vídeo: default WIDE_VOICE_VIDEO → sessões VIDEO usam telecom INTELBRAS (WideVoice).
# AGORA_RTC = legacy Agora RTC para VIDEO.
# SESSION_VIDEO_TELECOM_DRIVER=WIDE_VOICE_VIDEO
#
# Defaults para «Demo em 1 clique» no HTML (/telecom/lab/run-demo) — opcionais:
# Ramal autorizado na central a originar chamadas (`origem` do clicktocall) — ver painel WideVoice / Atendimento
# INTELBRAS_LAB_ORIGEM_RAMAL=0560
# INTELBRAS_LAB_DESTINO=5511999887766
# Lista opcional só dígitos (E.164 ou nacional) — botões «variante» no intelbras-test.html
# INTELBRAS_LAB_DESTINO_VARIANTS=557183141335,5571982809246
# Seeds homolog também preenchem ramal (`specialists.intelbras_ramal`) + `users.phone` do cliente demo:
# SEED_HOMOLOG_INTELBRAS_RAMAL=0560
# SEED_HOMOLOG_CLIENT_PHONE=5511999887766
#
# ─── Laboratório HTTP /public/intelbras-test.html (homolog) ───────────────────
# Expõe /api/v1/telecom/lab/ping|defaults|run-demo|clicktocall|liberarramal|statusramais|statusoperacoes — **desligado por defeito**.
# Em PRD: mantém false; se precisares, usa sempre INTELBRAS_TELECOM_LAB_SECRET forte.
# INTELBRAS_TELECOM_LAB_ENABLED=true
# INTELBRAS_TELECOM_LAB_SECRET=COLE_SEGREDO_LONGO_ex_openssl_rand_hex_32
# Logs `[WideVoice:clicktocall]` / `[telecom:lab]` no terminal (Docker). false desliga.
# INTELBRAS_LAB_CONSOLE_LOG=true

# ─── Mercado Pago — Fase 5 (Checkout transparente + Webhooks) ────────────────
# Ambiente da aplicação perante o MP: `sandbox` (testes) ou `production`. Controla qual access token usar.
# A mesma URL de webhook pode estar cadastrada no painel para ambos; a assinatura HMAC é validada igual.
MP_ENV=sandbox
# Access token sandbox (prefixo TEST-) — usado quando MP_ENV=sandbox
MP_ACCESS_TOKEN_SANDBOX=
# Access token produção (prefixo APP_USR-) — usado quando MP_ENV=production
MP_ACCESS_TOKEN_PRODUCTION=
# Compat: se só existir MP_ACCESS_TOKEN, é fallback para o modo actual
# MP_ACCESS_TOKEN=
MP_PUBLIC_KEY_SANDBOX=
MP_PUBLIC_KEY_PRODUCTION=
# Segredo de assinatura de webhooks (`x-signature`) — pode ser o mesmo valor no painel sandbox e produção
MP_WEBHOOK_SECRET=
# Logs: `true` (default) = JSON completo do webhook + resposta GET payment nos logs; `false` = só resumo
# MP_WEBHOOK_VERBOSE=true
# OAuth / app (opcional — integrações que exijam client credentials)
# MP_CLIENT_ID=
# MP_CLIENT_SECRET=
# Opcional: só dev — NUNCA em produção (`true` ignora HMAC).
# MP_WEBHOOK_VERIFY_DISABLED=false
# URL de notificação (sobrepõe `{API_PUBLIC_URL}/api/v1/payments/webhook`).
# MP_NOTIFICATION_URL=
# Catálogo opcional de pacotes: JSON mapa `id` → `{ amount_brl, credit_type, label }`
# MP_PACKAGES_JSON={"pacote_50":{"amount_brl":50,"credit_type":"PACOTE_SESSAO_UNICA","label":"Pacote R$50"}}
