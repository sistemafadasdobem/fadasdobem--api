# ─── Aplicação ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Versão exposta em /health e /ping (opcional; default no código: 1.0.0)
APP_VERSION=1.0.0
API_PUBLIC_URL=http://localhost:3000
# Esquema: `npm start` corre `migrations/` (recomendado). NÃO ative Sequelize sync em PRD com alter.
# true = apenas opt-in sync na app (`alter` só se SEQUELIZE_SYNC_ALTER=true). force ainda assim exige SEQUELIZE_SYNC_FORCE.
SEQUELIZE_SYNC=false
# Com SEQUELIZE_SYNC=true: altera colunas existentes (perigoso). Prefira novas entradas em migrations/.
SEQUELIZE_SYNC_ALTER=false
# Apaga e recria TODAS as tabelas. Pode correr sem SEQUELIZE_SYNC=true (ver app.js).
SEQUELIZE_SYNC_FORCE=false
# Atrás de reverse proxy (Easypanel, nginx): true para rate limit e req.ip corretos
TRUST_PROXY=false
# TRUST_PROXY_COUNT=1
# Homolog / staging: true desativa limite de tentativas em login e registo (5/IP e 10/email / 15 min). Evita HTTP 429 ao alternar cliente e taróloga.
# Em produção deixe vazio ou false.
# AUTH_RATE_LIMIT_DISABLED=true

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fadasdobem
DB_USER=postgres
DB_PASSWORD=COLE_SENHA_DO_POSTGRES
DB_LOGGING=false
# Opcional (PRD): sobrepõe host/user/pass acima quando preenchido
DATABASE_URL=
# PRD com SSL (ex.: RDS): defina true se necessário
DB_SSL=false

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_URL=

# ─── JWT (gere segredos longos, ex.: openssl rand -hex 32) ───────────────────
JWT_SECRET=GERE_SEGREDO_MINIMO_32_CARACTERES_EX_openssl_rand_hex_32
JWT_EXPIRES_IN=30m
JWT_ISSUER=fadasdobem-api
JWT_AUDIENCE=fadasdobem-clients

JWT_REFRESH_SECRET=GERE_OUTRO_SEGREDO_MINIMO_32_CARACTERES
JWT_REFRESH_EXPIRES_IN=12h

# ─── E-mail (Resend — `src/providers/mail/`) ───────────────────────────────────
RESEND_API_KEY=re_ColeSuaChaveResendAqui
EMAIL_FROM="Fadas do Bem <contato@seudominio.com.br>"

# ─── Evolution API ───────────────────────────────────────────────────────────
EVOLUTION_API_BASE_URL=https://COLE_URL_PUBLICA_DA_SUA_EVOLUTION_API
EVOLUTION_GLOBAL_API_KEY=COLE_SUA_EVOLUTION_GLOBAL_API_KEY
EVOLUTION_WEBHOOK_GLOBAL_URL=

# ─── Chatwoot ────────────────────────────────────────────────────────────────
CHATWOOT_BASE_URL=https://COLE_URL_PUBLICA_DO_SEU_CHATWOOT
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=COLE_SEU_TOKEN_USER_OU_PLATFORM_CHATWOOT
CHATWOOT_IA_HISTORY_N=30
# Se true (ou 1 / yes / on), webhook responde no Chatwoot com IA. false ou vazio = não responde (útil no dev).
CHATWOOT_IA_AUTO_REPLY=false
# Logs de diagnóstico webhook → IA (omitir ou true). false silencia `[chatwoot:webhook]` e relacionados neste fluxo.
CHATWOOT_WEBHOOK_LOG=true
# Opcional: só se quiseres restringir números na IA. Sem variável = todos (veja chatwoot.service.js).
CHATWOOT_IA_PHONE_WHITELIST=

# ─── Provedor de IA: anthropic | openai ───────────────────────────────────────
ACTIVE_AI_PROVIDER=anthropic

# ─── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-COLE_SUA_CHAVE_ANTHROPIC_AQUI
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_MAX_TOOL_ROUNDS=10
# Logs `[anthropic:claude]` (rounds, uso, latência). false silencia no PRD se necessário.
ANTHROPIC_SERVICE_LOG=true

# ─── OpenAI (Assistants v2) ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-COLE_SUA_CHAVE_OPENAI_OU_DEIXE_VAZIO
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_DISPLAY_NAME=
OPENAI_ASSISTANT_REGISTRY_SLUG=
OPENAI_ASSISTANT_ID=
OPENAI_RUN_POLL_MS=750
OPENAI_RUN_MAX_POLL_ATTEMPTS=60

# ─── Opcional ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=

# ─── Agora.io (RTC web — Fase 5 + Conversational AI REST) ────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Basic Auth Agora REST (kick/ban list, outros endpoints REST): Developer Toolkit → RESTful API
# Na API Conversational AI também pode usar `Authorization: agora token=<RTC token gerado no servidor>`
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Opcional: base da API Conversational AI (default https://api.agora.io)
# AGORA_CONVERSATIONAL_AI_BASE_URL=

# Homologação — após migrate: `npm run seed:homolog` cria client + taróloga + carteira (ver script).
# GET /api/v1/config/public expõe agora_app_id + e-mails + specialist_id da BD.
# SEED_HOMOLOG_EMAIL=homolog@fadasdobem.test
# SEED_HOMOLOG_PASSWORD=Homolog@2026
# SEED_HOMOLOG_SPECIALIST_EMAIL=tarologa.homolog@fadasdobem.test
# SEED_HOMOLOG_SPECIALIST_PASSWORD=TarologaHomolog@2026
# SEED_FORCE_PASSWORD_RESET=true

# ─── Intelbras Wide Voice — REST (click-to-call / hard cut) ───────────────────
# URL base da API (ex.: https://apiwidevoice.intelbras.com.br/api — confirmar com o suporte)
INTELBRAS_REST_URL=https://apiwidevoice.intelbras.com.br/api
INTELBRAS_REST_LOGIN=
INTELBRAS_REST_TOKEN=
# INTELBRAS_REST_TIMEOUT_MS=15000

# ─── Mercado Pago — Fase 5 (Checkout transparente + Webhooks) ────────────────
# Ambiente da aplicação perante o MP: `sandbox` (testes) ou `production`. Controla qual access token usar.
# A mesma URL de webhook pode estar cadastrada no painel para ambos; a assinatura HMAC é validada igual.
MP_ENV=sandbox
# Access token sandbox (prefixo TEST-) — usado quando MP_ENV=sandbox
MP_ACCESS_TOKEN_SANDBOX=
# Access token produção (prefixo APP_USR-) — usado quando MP_ENV=production
MP_ACCESS_TOKEN_PRODUCTION=
# Compat: se só existir MP_ACCESS_TOKEN, é fallback para o modo actual
# MP_ACCESS_TOKEN=
MP_PUBLIC_KEY_SANDBOX=
MP_PUBLIC_KEY_PRODUCTION=
# Segredo de assinatura de webhooks (`x-signature`) — pode ser o mesmo valor no painel sandbox e produção
MP_WEBHOOK_SECRET=
# Logs: `true` (default) = JSON completo do webhook + resposta GET payment nos logs; `false` = só resumo
# MP_WEBHOOK_VERBOSE=true
# OAuth / app (opcional — integrações que exijam client credentials)
# MP_CLIENT_ID=
# MP_CLIENT_SECRET=
# Opcional: só dev — NUNCA em produção (`true` ignora HMAC).
# MP_WEBHOOK_VERIFY_DISABLED=false
# URL de notificação (sobrepõe `{API_PUBLIC_URL}/api/v1/payments/webhook`).
# MP_NOTIFICATION_URL=
# Catálogo opcional de pacotes: JSON mapa `id` → `{ amount_brl, credit_type, label }`
# MP_PACKAGES_JSON={"pacote_50":{"amount_brl":50,"credit_type":"PACOTE_SESSAO_UNICA","label":"Pacote R$50"}}
